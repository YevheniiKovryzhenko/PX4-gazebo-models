#!/bin/sh
#
# @name S2F-X200 - Gazebo (experimental)
# @type Standard VTOL
# @class VTOL
# @maintainer S2F-X200 project
#

. ${R}etc/init.d/airframes/22000_s2f_x200_simulink

param set-default SMG_TRAJ_DIR 0

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=s2f_x200}
param set-default SIM_GZ_EN 1

# The model's speed ceiling is 8000 RPM = 837.758 rad/s. The bridge uses integer
# endpoints, so use 838. These are simulator channels, not physical pin routing.
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105
param set-default SIM_GZ_EC_MAX1 838
param set-default SIM_GZ_EC_MAX2 838
param set-default SIM_GZ_EC_MAX3 838
param set-default SIM_GZ_EC_MAX4 838
param set-default SIM_GZ_EC_MAX5 838

param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_FUNC3 203
param set-default SIM_GZ_SV_FUNC4 204
param set-default SIM_GZ_SV_FUNC5 205
param set-default SIM_GZ_SV_FUNC6 206
param set-default SIM_GZ_SV_FUNC7 207
param set-default SIM_GZ_SV_MINA1 -30
param set-default SIM_GZ_SV_MINA2 -30
param set-default SIM_GZ_SV_MINA3 -30
param set-default SIM_GZ_SV_MINA4 -30
param set-default SIM_GZ_SV_MINA5 -30
param set-default SIM_GZ_SV_MINA6 -30
param set-default SIM_GZ_SV_MINA7 -30
param set-default SIM_GZ_SV_MAXA1 30
param set-default SIM_GZ_SV_MAXA2 30
param set-default SIM_GZ_SV_MAXA3 30
param set-default SIM_GZ_SV_MAXA4 30
param set-default SIM_GZ_SV_MAXA5 30
param set-default SIM_GZ_SV_MAXA6 30
param set-default SIM_GZ_SV_MAXA7 30

# Nominal lift-thrust fraction at hover for this approximation. Calibrate the
# controller's reported thrust to the same normalization, not mean motor PWM.
param set-default MPC_THR_HOVER 0.4

# Match the stock Gazebo VTOL workaround for simulated ESC current reporting.
param set-default FD_ACT_EN 0
param set-default FD_ESCS_EN 0
